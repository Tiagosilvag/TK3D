// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id                            Int          @id @default(1)
  energyCostPerKwh              Decimal      @default(1.00) @db.Decimal(10, 4)
  laborCostPerHour              Decimal      @default(10.00) @db.Decimal(10, 2)
  failureRatePercent            Decimal      @default(0.10) @db.Decimal(5, 4)
  marketplaceFeePercent         Decimal      @default(0.20) @db.Decimal(5, 4)
  taxPercent                    Decimal      @default(0.055) @db.Decimal(5, 4)
  marketplaceFixedFee           Decimal      @default(4.00) @db.Decimal(10, 2)
  defaultMarkup                 Decimal      @default(2.00) @db.Decimal(6, 2)
  annualMaintenancePercent      Decimal      @default(0.10) @db.Decimal(5, 4)
  annualUsageHours              Decimal      @default(2000) @db.Decimal(10, 2)
  // Configurações §3 — Precificação
  desiredMarginPercent          Decimal      @default(0.30) @db.Decimal(5, 4)
  defaultDiscountPercent        Decimal      @default(0) @db.Decimal(5, 4)
  // Configurações §3 — Estoque (acessórios/insumos; Filamento continua com
  // limiares fixos 30%/10%, não muda — ver lib/costing.ts getStockStatus)
  stockLowThresholdPercent      Decimal      @default(0.30) @db.Decimal(5, 4)
  stockCriticalThresholdPercent Decimal      @default(0.10) @db.Decimal(5, 4)
  // Configurações §3 — Composição do custo (cada flag habilita/desabilita a
  // contribuição do termo correspondente no subtotal/total calculado por
  // calculateProductCost, ver lib/costing.ts)
  includeDepreciation           Boolean      @default(true)
  includeEnergyCost             Boolean      @default(true)
  includeMaintenance            Boolean      @default(true)
  includeLaborCost              Boolean      @default(true)
  includeFailureRate            Boolean      @default(true)
  includeFilamentCost           Boolean      @default(true)
  includeAccessoriesCost        Boolean      @default(true)
  includeSuppliesCost           Boolean      @default(true)
  includePackagingCost          Boolean      @default(true)
  // Configurações §3 — Arredondamento (aplicado só ao preço final sugerido/
  // marketplace via lib/costing.ts#applyRounding, nunca aos componentes)
  roundingMode                  RoundingMode @default(NONE)
  updatedAt                     DateTime     @updatedAt
}

enum RoundingMode {
  NONE
  R90 // termina em ,90
  R99 // termina em ,99
  R00 // termina em ,00
}

model Printer {
  id                     String          @id @default(cuid())
  name                   String          @unique
  purchasePrice          Decimal         @db.Decimal(10, 2)
  depreciationHours      Decimal         @db.Decimal(10, 2)
  avgPowerConsumptionKwh Decimal         @db.Decimal(6, 4)
  active                 Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  products               Product[]
  productionRuns         ProductionRun[]
}

enum FilamentMaterial {
  PLA
  PETG
  TPU
  OUTRO
}

model MaterialDefaults {
  material    FilamentMaterial @id
  diameterMm  Decimal          @db.Decimal(4, 2)
  densityGCm3 Decimal          @db.Decimal(5, 3)
  nozzleTempC Int
  bedTempC    Int
}

model Filament {
  id                String           @id @default(cuid())
  manufacturer      String
  material          FilamentMaterial
  colorName         String
  colorHex          String
  rollNumber        Int
  spoolWeightKg     Decimal          @db.Decimal(6, 3)
  spoolPrice        Decimal          @db.Decimal(10, 2)
  initialStockGrams Decimal          @db.Decimal(10, 2)
  currentStockGrams Decimal          @db.Decimal(10, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  products          Product[]
  productionRuns    ProductionRun[]

  @@unique([manufacturer, material, colorName, rollNumber])
}

model PackagingItem {
  id        String    @id @default(cuid())
  name      String    @unique
  unitCost  Decimal   @db.Decimal(10, 4)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Tipos de acessório (spec: Configurações → Tipos de acessório), movidos de
// enum fixo para tabela editável em runtime — CRUD completo (criar,
// renomear, remover-se-não-usado) via actions/accessoryTypes.ts. `id` fica
// livre para o Prisma gerar cuid() em tipos novos; os 5 tipos originais
// mantêm o próprio nome do antigo enum como id (ver migração
// accessory_types_table), preservando toda referência existente sem
// precisar reescrever nenhuma linha de Accessory.
model AccessoryTypeRecord {
  id          String      @id @default(cuid())
  name        String      @unique
  createdAt   DateTime    @default(now())
  accessories Accessory[]

  @@map("accessory_types")
}

model Accessory {
  id            String                  @id @default(cuid())
  name          String
  // FK escalar pra accessory_types.id — chamado "type" (não "typeId") de
  // propósito: mantém o nome do campo em accessorySchema/createAccessory e
  // em toda chamada de teste existente (`type: 'MOSQUETAO'`) idêntico ao
  // que já era quando "type" era o próprio enum, zero churn nesses
  // call sites por causa da migração enum -> tabela.
  type          String
  accessoryType AccessoryTypeRecord     @relation(fields: [type], references: [id])
  colorName     String                  @default("") // "" = sem cor / genérico
  colorHex      String?
  currentStock  Decimal                 @db.Decimal(10, 2) // sempre em unidades
  avgUnitCost   Decimal                 @db.Decimal(10, 4) // custo médio ponderado, recalculado a cada compra
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  purchases     AccessoryPurchase[]
  usages        ProductAccessoryUsage[]

  @@unique([name, type, colorName])
}

model AccessoryPurchase {
  id           String    @id @default(cuid())
  accessoryId  String
  // onDelete: Cascade — purchase history is owned by its Accessory (it only
  // exists to explain how that accessory's stock/avgUnitCost got where they
  // are); Product's own accessoryId FK (no cascade) is the reference that
  // actually blocks a physical deleteAccessory (spec §7 / task-3 brief).
  accessory    Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  quantity     Decimal   @db.Decimal(10, 2)
  totalCost    Decimal   @db.Decimal(10, 2)
  purchaseDate DateTime
  notes        String?
  createdAt    DateTime  @default(now())
}

enum SupplyUnit {
  UN
  ML
  G
  M // metro
  OUTRO
}

model Supply {
  id           String               @id @default(cuid())
  name         String               @unique
  unit         SupplyUnit
  currentStock Decimal              @db.Decimal(10, 3)
  avgUnitCost  Decimal              @db.Decimal(10, 4) // custo médio por unidade de medida cadastrada, recalculado a cada compra
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  purchases    SupplyPurchase[]
  usages       ProductSupplyUsage[]
}

model SupplyPurchase {
  id           String   @id @default(cuid())
  supplyId     String
  // onDelete: Cascade — purchase history is owned by its Supply (it only
  // exists to explain how that supply's stock/avgUnitCost got where they
  // are); ProductSupplyUsage's own supplyId FK (ON DELETE RESTRICT already,
  // from the original schema) is the reference that actually blocks a
  // physical deleteSupply (task-4 brief, mirroring task-3's Accessory).
  supply       Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  quantity     Decimal  @db.Decimal(10, 3)
  totalCost    Decimal  @db.Decimal(10, 2)
  purchaseDate DateTime
  notes        String?
  createdAt    DateTime @default(now())
}

enum FinishingType {
  NENHUM
  CANETA_VERNIZ
  RESINA_UV
  OUTRO
}

model Product {
  id                    String                  @id @default(cuid())
  name                  String
  category              String                  @default("Chaveiro")
  printerId             String
  printer               Printer                 @relation(fields: [printerId], references: [id])
  filamentId            String
  filament              Filament                @relation(fields: [filamentId], references: [id])
  weightGrams           Decimal                 @db.Decimal(10, 2)
  printTimeHours        Decimal                 @db.Decimal(10, 3)
  laborTimeHours        Decimal                 @db.Decimal(10, 3)
  packagingItemId       String?
  packagingItem         PackagingItem?          @relation(fields: [packagingItemId], references: [id])
  finishingType         FinishingType           @default(NENHUM)
  usesGlue              Boolean                 @default(false)
  notes                 String?
  active                Boolean                 @default(true)
  // Preço §2: gravados só por ação explícita do usuário ("Aplicar preço
  // calculado"), nunca recalculados automaticamente em background. A tela
  // sempre mostra uma prévia calculada ao vivo a partir de Settings; estes
  // dois campos só existem pra persistir o que o usuário confirmou aplicar.
  suggestedPrice        Decimal?                @db.Decimal(10, 2)
  marketplacePrice      Decimal?                @db.Decimal(10, 2)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  supplyUsages          ProductSupplyUsage[]
  // Generalização da antiga FK única accessoryId (spec §2, task-5 brief):
  // mesmo padrão de ProductSupplyUsage, uma lista produto↔acessório com
  // quantidade em vez de "no máximo um acessório".
  accessoryUsages       ProductAccessoryUsage[]
  productionRuns        ProductionRun[]
  sales                 Sale[]
  consignmentDeliveries ConsignmentDelivery[]
  photos                ProductPhoto[]
}

model ProductPhoto {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
}

model ProductSupplyUsage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId  String
  supply    Supply  @relation(fields: [supplyId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)

  @@unique([productId, supplyId])
}

// Generalizes the old Product.accessoryId single FK into a list (spec §2,
// task-5 brief) -- exact same shape/relations/cascade behavior as
// ProductSupplyUsage above: onDelete Cascade on the product side (a usage
// row only exists to describe its product's ficha técnica, so it goes away
// with the product), default (Restrict) on the accessory side (blocks
// deleteAccessory while any product still references it -- same guarantee
// Product_accessoryId_fkey had after 20260907220500_accessory_fk_restrict).
model ProductAccessoryUsage {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessoryId String
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  quantity    Decimal   @db.Decimal(10, 2)

  @@unique([productId, accessoryId])
}

model ProductionRun {
  id              String           @id @default(cuid())
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  printerId       String
  printer         Printer          @relation(fields: [printerId], references: [id])
  filamentId      String
  filament        Filament         @relation(fields: [filamentId], references: [id])
  date            DateTime
  quantityPlanned Int
  quantitySuccess Int
  quantityFailed  Int
  gramsUsed       Decimal          @db.Decimal(10, 2)
  gramsWasted     Decimal          @db.Decimal(10, 2)
  timeWastedHours Decimal          @db.Decimal(10, 3)
  notes           String?
  // Custo histórico (spec §4/§5.4, task-7 brief): calculated ONCE at creation
  // time via lib/costing.ts#buildProductionCostSnapshot and never rewritten
  // afterwards -- every later screen reads this instead of recalculating, and
  // cancelProductionRun's reversal reads consumedResources from here (not the
  // product's current ficha técnica, which may have since changed). Nullable
  // because pre-existing runs (created before this column existed) genuinely
  // have no snapshot -- there's no historical Settings/Printer/Filament state
  // to reconstruct one retroactively (same "don't invent data" precedent as
  // Tasks 3/4's Accessory/Supply purchase-history backfill). createProductionRun
  // always populates it for every new run going forward.
  costSnapshot    Json?
  // Ciclo de vida (spec §5.4): computed once at creation (CONCLUIDA/PARCIAL/
  // COM_FALHAS) or set explicitly by cancelProductionRun (CANCELADA) -- never
  // recomputed afterwards. @default(CONCLUIDA) exists only to satisfy the
  // NOT NULL constraint for rows that predate this column (backfilled more
  // precisely by the migration itself); every write from application code
  // sets this field explicitly.
  status          ProductionStatus @default(CONCLUIDA)
  wasteReason     WasteReason?
  cancelReason    String?
  cancelDate      DateTime?
  createdAt       DateTime         @default(now())
}

enum WasteReason {
  FALHA_IMPRESSAO
  ERRO_CONFIGURACAO
  SUPORTE_EXCESSIVO
  QUEBRA
  TESTE
  PURGA
  TROCA_FILAMENTO
  OUTRO
}

enum ProductionStatus {
  CONCLUIDA
  PARCIAL
  COM_FALHAS
  CANCELADA
}

enum SaleChannel {
  DIRETA
  MARKETPLACE
}

model Sale {
  id              String      @id @default(cuid())
  channel         SaleChannel
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal     @db.Decimal(10, 2)
  saleDate        DateTime
  buyerOrPlatform String?
  notes           String?
  // Custo histórico (task-10 brief, new feature -- mirrors ProductionRun's
  // costSnapshot exactly, spec §4 pattern extended here per explicit user
  // request after the final review): calculated ONCE at creation time via
  // createSale (lib/costing.ts#buildSaleCostSnapshot, from
  // getProductCostBreakdown's then-current Printer/Filament/Accessory/
  // Supply/Settings values) and never rewritten afterwards -- altering
  // Settings/Printer/Filament/Accessory/Supply later must never change an
  // already-recorded sale's displayed profit. Nullable because pre-existing
  // sales (created before this column existed) genuinely have no snapshot --
  // there's no historical state to reconstruct one retroactively (same
  // "don't invent data" precedent as ProductionRun.costSnapshot and the
  // Accessory/Supply purchase-history backfill). getSaleProfit() falls back
  // to a live recompute only for such legacy rows.
  costSnapshot    Json?
  createdAt       DateTime    @default(now())
}

model ConsignmentPartner {
  id                       String                @id @default(cuid())
  name                     String
  defaultCommissionPercent Decimal               @db.Decimal(5, 4)
  notes                    String?
  active                   Boolean               @default(true)
  createdAt                DateTime              @default(now())
  deliveries               ConsignmentDelivery[]
}

model ConsignmentDelivery {
  id                String                  @id @default(cuid())
  partnerId         String
  partner           ConsignmentPartner      @relation(fields: [partnerId], references: [id])
  productId         String
  product           Product                 @relation(fields: [productId], references: [id])
  quantityDelivered Int
  unitPrice         Decimal                 @db.Decimal(10, 2)
  deliveryDate      DateTime
  notes             String?
  createdAt         DateTime                @default(now())
  saleReports       ConsignmentSaleReport[]
}

model ConsignmentSaleReport {
  id                String              @id @default(cuid())
  deliveryId        String
  delivery          ConsignmentDelivery @relation(fields: [deliveryId], references: [id])
  quantitySold      Int
  reportDate        DateTime
  commissionPercent Decimal             @db.Decimal(5, 4)
  notes             String?
  createdAt         DateTime            @default(now())
}
