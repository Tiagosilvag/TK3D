// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id                            Int          @id @default(1)
  energyCostPerKwh              Decimal      @default(1.00) @db.Decimal(10, 4)
  laborCostPerHour              Decimal      @default(10.00) @db.Decimal(10, 2)
  failureRatePercent            Decimal      @default(0.10) @db.Decimal(5, 4)
  marketplaceFeePercent         Decimal      @default(0.20) @db.Decimal(5, 4)
  taxPercent                    Decimal      @default(0.055) @db.Decimal(5, 4)
  marketplaceFixedFee           Decimal      @default(4.00) @db.Decimal(10, 2)
  defaultMarkup                 Decimal      @default(2.00) @db.Decimal(6, 2)
  annualMaintenancePercent      Decimal      @default(0.10) @db.Decimal(5, 4)
  annualUsageHours              Decimal      @default(2000) @db.Decimal(10, 2)
  // Configurações §3 — Precificação
  desiredMarginPercent          Decimal      @default(0.30) @db.Decimal(5, 4)
  defaultDiscountPercent        Decimal      @default(0) @db.Decimal(5, 4)
  // Configurações §3 — Estoque (acessórios/insumos; Filamento continua com
  // limiares fixos 30%/10%, não muda — ver lib/costing.ts getStockStatus)
  stockLowThresholdPercent      Decimal      @default(0.30) @db.Decimal(5, 4)
  stockCriticalThresholdPercent Decimal      @default(0.10) @db.Decimal(5, 4)
  // Configurações §3 — Composição do custo (cada flag habilita/desabilita a
  // contribuição do termo correspondente no subtotal/total calculado por
  // calculateProductCost, ver lib/costing.ts)
  includeDepreciation           Boolean      @default(true)
  includeEnergyCost             Boolean      @default(true)
  includeMaintenance            Boolean      @default(true)
  includeLaborCost              Boolean      @default(true)
  includeFailureRate            Boolean      @default(true)
  includeFilamentCost           Boolean      @default(true)
  includeAccessoriesCost        Boolean      @default(true)
  includeSuppliesCost           Boolean      @default(true)
  includePackagingCost          Boolean      @default(true)
  // Configurações §3 — Arredondamento (aplicado só ao preço final sugerido/
  // marketplace via lib/costing.ts#applyRounding, nunca aos componentes)
  roundingMode                  RoundingMode @default(NONE)
  updatedAt                     DateTime     @updatedAt
}

enum RoundingMode {
  NONE
  R90 // termina em ,90
  R99 // termina em ,99
  R00 // termina em ,00
}

model Printer {
  id                     String          @id @default(cuid())
  name                   String          @unique
  // Apelido opcional (spec "melhorias Impressoras"): nome do modelo (`name`,
  // único, usado em toda referência/FK) fica separado do apelido informal
  // que o usuário dá pra máquina física (ex.: name="Anycubic Kobra X",
  // nickname="Cassiopéia") -- antes só existia `name`, que acumulava os
  // dois papéis.
  nickname               String?
  purchasePrice          Decimal         @db.Decimal(10, 2)
  depreciationHours      Decimal         @db.Decimal(10, 2)
  avgPowerConsumptionKwh Decimal         @db.Decimal(6, 4)
  // Tarifa de energia (R$/kWh) e manutenção (R$/h) por impressora (spec
  // "melhorias Impressoras"): antes vinham de Settings.energyCostPerKwh
  // (global, todas as impressoras pagavam a mesma tarifa) e de
  // purchasePrice * Settings.annualMaintenancePercent /
  // Settings.annualUsageHours (fórmula genérica calculada, não um valor
  // real por máquina). Cada impressora pode estar numa tomada/circuito
  // diferente e ter uma manutenção real diferente, então os dois viram
  // input direto por impressora -- Settings mantém os 3 campos antigos no
  // schema (fora do escopo mudar a tela de Configurações), só param de
  // alimentar o custo de impressora a partir daqui. `@default` só existe
  // pra impressora criada fora do formulário (seed, fixture de teste) --
  // createPrinter/updatePrinter (lib/validation/printer.ts) sempre exigem
  // os dois campos explicitamente do usuário, nunca dependem do default.
  energyCostPerKwh       Decimal         @default(1.00) @db.Decimal(10, 4)
  maintenanceCostPerHour Decimal         @default(0) @db.Decimal(10, 4)
  active                 Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  products               Product[]
  productionRuns         ProductionRun[]
  productParts           ProductPart[]
}

enum FilamentMaterial {
  PLA
  PETG
  TPU
  OUTRO
}

model MaterialDefaults {
  material    FilamentMaterial @id
  diameterMm  Decimal          @db.Decimal(4, 2)
  densityGCm3 Decimal          @db.Decimal(5, 3)
  nozzleTempC Int
  bedTempC    Int
}

model Filament {
  id                String           @id @default(cuid())
  manufacturer      String
  material          FilamentMaterial
  colorName         String
  colorHex          String
  rollNumber        Int
  spoolWeightKg     Decimal          @db.Decimal(6, 3)
  spoolPrice        Decimal          @db.Decimal(10, 2)
  initialStockGrams Decimal          @db.Decimal(10, 2)
  currentStockGrams Decimal          @db.Decimal(10, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  products          Product[]
  productionRuns    ProductionRun[]
  productPartFilaments ProductPartFilament[]
  productionRunFilamentUsages ProductionRunFilamentUsage[]

  @@unique([manufacturer, material, colorName, rollNumber])
}

model PackagingItem {
  id        String    @id @default(cuid())
  name      String    @unique
  unitCost  Decimal   @db.Decimal(10, 4)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Tipos de acessório (spec: Configurações → Tipos de acessório), movidos de
// enum fixo para tabela editável em runtime — CRUD completo (criar,
// renomear, remover-se-não-usado) via actions/accessoryTypes.ts. `id` fica
// livre para o Prisma gerar cuid() em tipos novos; os 5 tipos originais
// mantêm o próprio nome do antigo enum como id (ver migração
// accessory_types_table), preservando toda referência existente sem
// precisar reescrever nenhuma linha de Accessory.
model AccessoryTypeRecord {
  id          String      @id @default(cuid())
  name        String      @unique
  createdAt   DateTime    @default(now())
  accessories Accessory[]

  @@map("accessory_types")
}

model Accessory {
  id            String                  @id @default(cuid())
  name          String
  // FK escalar pra accessory_types.id — chamado "type" (não "typeId") de
  // propósito: mantém o nome do campo em accessorySchema/createAccessory e
  // em toda chamada de teste existente (`type: 'MOSQUETAO'`) idêntico ao
  // que já era quando "type" era o próprio enum, zero churn nesses
  // call sites por causa da migração enum -> tabela.
  type          String
  accessoryType AccessoryTypeRecord     @relation(fields: [type], references: [id])
  colorName     String                  @default("") // "" = sem cor / genérico
  colorHex      String?
  currentStock  Decimal                 @db.Decimal(10, 2) // sempre em unidades
  avgUnitCost   Decimal                 @db.Decimal(10, 4) // custo médio ponderado, recalculado a cada compra
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  purchases     AccessoryPurchase[]
  usages        ProductAccessoryUsage[]

  @@unique([name, type, colorName])
}

model AccessoryPurchase {
  id           String    @id @default(cuid())
  accessoryId  String
  // onDelete: Cascade — purchase history is owned by its Accessory (it only
  // exists to explain how that accessory's stock/avgUnitCost got where they
  // are); Product's own accessoryId FK (no cascade) is the reference that
  // actually blocks a physical deleteAccessory (spec §7 / task-3 brief).
  accessory    Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  quantity     Decimal   @db.Decimal(10, 2)
  totalCost    Decimal   @db.Decimal(10, 2)
  purchaseDate DateTime
  notes        String?
  createdAt    DateTime  @default(now())
}

enum SupplyUnit {
  UN
  ML
  G
  M // metro
  OUTRO
}

model Supply {
  id           String               @id @default(cuid())
  name         String               @unique
  unit         SupplyUnit
  currentStock Decimal              @db.Decimal(10, 3)
  avgUnitCost  Decimal              @db.Decimal(10, 4) // custo médio por unidade de medida cadastrada, recalculado a cada compra
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  purchases    SupplyPurchase[]
  usages       ProductSupplyUsage[]
}

model SupplyPurchase {
  id           String   @id @default(cuid())
  supplyId     String
  // onDelete: Cascade — purchase history is owned by its Supply (it only
  // exists to explain how that supply's stock/avgUnitCost got where they
  // are); ProductSupplyUsage's own supplyId FK (ON DELETE RESTRICT already,
  // from the original schema) is the reference that actually blocks a
  // physical deleteSupply (task-4 brief, mirroring task-3's Accessory).
  supply       Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  quantity     Decimal  @db.Decimal(10, 3)
  totalCost    Decimal  @db.Decimal(10, 2)
  purchaseDate DateTime
  notes        String?
  createdAt    DateTime @default(now())
}

enum FinishingType {
  NENHUM
  CANETA_VERNIZ
  RESINA_UV
  OUTRO
}

model Product {
  id                    String                  @id @default(cuid())
  name                  String
  category              String                  @default("Chaveiro")
  // 2.1 Produto composto (BOM): quando isComposite=true, estes 4 campos
  // deixam de ser "a" impressora/filamento/peso/tempo do produto (que não
  // fazem mais sentido — cada ProductPart tem os seus) e passam a guardar
  // um resumo derivado (impressora/filamento da 1ª parte, soma de
  // peso/tempo entre partes), escrito automaticamente por
  // createProduct/updateProduct (actions/products.ts). Mantidos NOT NULL
  // de propósito -- tornar esses 4 campos opcionais tocaria toda leitura
  // não-nula existente (getProductCostBreakdown, createProductionRun,
  // autofill de produção, etc.); o resumo derivado é inofensivo e ainda
  // útil (ex.: "peso total" numa listagem), e getProductCostBreakdown já
  // ignora esses 4 campos por completo quando isComposite=true, somando o
  // custo de cada ProductPart em vez deles.
  isComposite           Boolean                 @default(false)
  printerId             String
  printer               Printer                 @relation(fields: [printerId], references: [id])
  filamentId            String
  filament              Filament                @relation(fields: [filamentId], references: [id])
  weightGrams           Decimal                 @db.Decimal(10, 2)
  printTimeHours        Decimal                 @db.Decimal(10, 3)
  laborTimeHours        Decimal                 @db.Decimal(10, 3)
  parts                 ProductPart[]
  assemblies            ProductAssembly[]
  packagingItemId       String?
  packagingItem         PackagingItem?          @relation(fields: [packagingItemId], references: [id])
  finishingType         FinishingType           @default(NENHUM)
  usesGlue              Boolean                 @default(false)
  notes                 String?
  active                Boolean                 @default(true)
  // Preço §2: gravados só por ação explícita do usuário ("Aplicar preço
  // calculado"), nunca recalculados automaticamente em background. A tela
  // sempre mostra uma prévia calculada ao vivo a partir de Settings; estes
  // dois campos só existem pra persistir o que o usuário confirmou aplicar.
  suggestedPrice        Decimal?                @db.Decimal(10, 2)
  marketplacePrice      Decimal?                @db.Decimal(10, 2)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  supplyUsages          ProductSupplyUsage[]
  // Generalização da antiga FK única accessoryId (spec §2, task-5 brief):
  // mesmo padrão de ProductSupplyUsage, uma lista produto↔acessório com
  // quantidade em vez de "no máximo um acessório".
  accessoryUsages       ProductAccessoryUsage[]
  productionRuns        ProductionRun[]
  sales                 Sale[]
  consignmentDeliveries ConsignmentDelivery[]
  photos                ProductPhoto[]
  orders                Order[]
}

// 2.1 Produto composto (BOM): uma peça que precisa ser impressa
// separadamente e depois montada (2.3, ainda não implementado) pra formar
// 1 unidade do Product pai. onDelete Cascade no lado do produto (a peça só
// existe pra descrever a ficha técnica desse produto composto, some com
// ele); ProductionRun.productPartId aponta pra cá sem cascade -- uma peça
// com histórico de produção não pode ser removida da lista sem antes lidar
// com esse histórico (mesma guarda de FK-restrict já usada em
// Accessory/Supply nesta base).
model ProductPart {
  id              String                @id @default(cuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  printerId       String
  printer         Printer               @relation(fields: [printerId], references: [id])
  // Ajuste "peça multi-filamento": uma peça pode precisar de mais de uma
  // cor/filamento AO MESMO TEMPO (impressão multi-material -- ex.: corpo
  // preto 15g + detalhe verde 8g + olho branco 3g na MESMA impressão).
  // filamentId/weightGrams únicos viraram ProductPartFilament (1 linha por
  // componente da receita); pelo menos 1 componente sempre existe --
  // "peça de cor única" é só o caso de 1 componente só. weightGrams total
  // da peça (usado em ProductionRunForm/relatórios que só precisam do
  // peso agregado) é a soma dos componentes, nunca guardado aqui pra não
  // duplicar fonte de verdade.
  filamentComponents ProductPartFilament[]
  printTimeHours  Decimal               @db.Decimal(10, 3)
  // Quantidade dessa peça necessária pra montar 1 unidade do produto final.
  quantityPerUnit Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  productionRuns  ProductionRun[]

  @@unique([productId, name])
}

// Um componente de filamento da receita de uma ProductPart -- 1 linha por
// cor usada simultaneamente naquela peça (a maioria das peças tem só 1).
// onDelete Cascade no lado da peça (só existe pra descrever a receita
// dela); sem cascade no lado do Filament -- um filamento usado numa
// receita não pode ser excluído fisicamente sem antes tirá-lo da receita
// (mesma guarda de FK-restrict já usada em Accessory/Supply).
model ProductPartFilament {
  id            String      @id @default(cuid())
  productPartId String
  productPart   ProductPart @relation(fields: [productPartId], references: [id], onDelete: Cascade)
  filamentId    String
  filament      Filament    @relation(fields: [filamentId], references: [id], onDelete: Restrict)
  weightGrams   Decimal     @db.Decimal(10, 2)
}

// 2.3 Montagem: cada confirmação de montagem vira UMA linha aqui --
// `quantity` unidades do produto composto foram montadas, consumindo
// quantity × ProductPart.quantityPerUnit de CADA peça (todas as peças de
// um produto são sempre consumidas na mesma proporção da ficha técnica,
// então não precisa uma tabela de consumo por peça: dá pra derivar quanto
// cada peça já foi consumida a partir só desta soma × quantityPerUnit).
// "Estoque disponível de uma peça" e "produzido" de um produto composto
// (getOwnStockSummary, lib/reports.ts) leem esta tabela -- não existe
// decremento físico de um contador em outro lugar, tudo é derivado.
model ProductAssembly {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  // Ajuste "cor na montagem": pra cada peça de UM componente de filamento
  // (cor pode variar entre lotes -- ver ProductPart.filamentComponents),
  // a cor efetivamente escolhida nesta leva de montagem: um objeto
  // { [productPartId]: filamentId }. Peças com receita multi-filamento
  // fixa (>1 componente) nunca entram aqui -- não têm cor variável, então
  // não há escolha a registrar. Congelado no momento da montagem, igual
  // costSnapshot -- nunca reescrito depois. Nulo em montagens anteriores a
  // esse ajuste (histórico sem informação de cor, nunca inventada
  // retroativamente).
  colorChoices Json?
  assembledAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
}

model ProductPhoto {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
}

model ProductSupplyUsage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId  String
  supply    Supply  @relation(fields: [supplyId], references: [id])
  quantity  Decimal @db.Decimal(10, 3)

  @@unique([productId, supplyId])
}

// Generalizes the old Product.accessoryId single FK into a list (spec §2,
// task-5 brief) -- exact same shape/relations/cascade behavior as
// ProductSupplyUsage above: onDelete Cascade on the product side (a usage
// row only exists to describe its product's ficha técnica, so it goes away
// with the product), default (Restrict) on the accessory side (blocks
// deleteAccessory while any product still references it -- same guarantee
// Product_accessoryId_fkey had after 20260907220500_accessory_fk_restrict).
model ProductAccessoryUsage {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  accessoryId String
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  quantity    Decimal   @db.Decimal(10, 2)

  @@unique([productId, accessoryId])
}

model ProductionRun {
  id              String           @id @default(cuid())
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  // 2.1 Produto composto: quando presente, esta produção é de UMA peça
  // específica de um produto composto (não do produto pronto) -- o custo
  // do snapshot então reflete só filamento+impressora+energia dessa peça
  // (embalagem/insumos/acessórios/mão de obra entram na montagem, 2.3,
  // ainda não implementada). Nunca preenchido pra produto simples.
  productPartId   String?
  productPart     ProductPart?     @relation(fields: [productPartId], references: [id], onDelete: Restrict)
  printerId       String
  printer         Printer          @relation(fields: [printerId], references: [id])
  filamentId      String
  filament        Filament         @relation(fields: [filamentId], references: [id])
  date            DateTime
  quantityPlanned Int
  quantitySuccess Int
  quantityFailed  Int
  gramsUsed       Decimal          @db.Decimal(10, 2)
  gramsWasted     Decimal          @db.Decimal(10, 2)
  timeWastedHours Decimal          @db.Decimal(10, 3)
  notes           String?
  // Custo histórico (spec §4/§5.4, task-7 brief): calculated ONCE at creation
  // time via lib/costing.ts#buildProductionCostSnapshot and never rewritten
  // afterwards -- every later screen reads this instead of recalculating, and
  // cancelProductionRun's reversal reads consumedResources from here (not the
  // product's current ficha técnica, which may have since changed). Nullable
  // because pre-existing runs (created before this column existed) genuinely
  // have no snapshot -- there's no historical Settings/Printer/Filament state
  // to reconstruct one retroactively (same "don't invent data" precedent as
  // Tasks 3/4's Accessory/Supply purchase-history backfill). createProductionRun
  // always populates it for every new run going forward.
  costSnapshot    Json?
  // Ciclo de vida (spec §5.4): computed once at creation (CONCLUIDA/PARCIAL/
  // COM_FALHAS) or set explicitly by cancelProductionRun (CANCELADA) -- never
  // recomputed afterwards. @default(CONCLUIDA) exists only to satisfy the
  // NOT NULL constraint for rows that predate this column (backfilled more
  // precisely by the migration itself); every write from application code
  // sets this field explicitly.
  status          ProductionStatus @default(CONCLUIDA)
  wasteReason     WasteReason?
  cancelReason    String?
  cancelDate      DateTime?
  createdAt       DateTime         @default(now())
  // Ajuste "peça multi-filamento": só populado quando a peça produzida
  // (productPart) tem MAIS DE 1 componente de filamento -- nesse caso
  // filamentId/gramsUsed/gramsWasted acima guardam o PRIMEIRO componente
  // (compat com telas/relatórios que só leem o campo escalar) e esta
  // lista guarda o consumo real de CADA cor da receita. Vazio pra toda
  // produção de produto simples ou de peça de 1 filamento só -- que
  // continuam decrementando estoque só pelos campos escalares acima,
  // sem nenhuma mudança de comportamento.
  filamentUsages  ProductionRunFilamentUsage[]
}

// Consumo real de UM componente de filamento de uma produção de peça
// multi-filamento (ver ProductionRun.filamentUsages acima). Sem cascade
// pro lado do ProductionRun por padrão (Restrict) seria estranho já que
// isso é conteúdo interno do próprio run -- cascade explícito: some junto
// se o run for apagado (deleteProductionRun já reverte estoque antes).
model ProductionRunFilamentUsage {
  id              String        @id @default(cuid())
  productionRunId String
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  filamentId      String
  filament        Filament      @relation(fields: [filamentId], references: [id], onDelete: Restrict)
  gramsUsed       Decimal       @db.Decimal(10, 2)
  gramsWasted     Decimal       @db.Decimal(10, 2)
}

enum WasteReason {
  FALHA_IMPRESSAO
  ERRO_CONFIGURACAO
  SUPORTE_EXCESSIVO
  QUEBRA
  TESTE
  PURGA
  TROCA_FILAMENTO
  OUTRO
}

enum ProductionStatus {
  CONCLUIDA
  PARCIAL
  COM_FALHAS
  CANCELADA
}

// 3.6: canal de venda passou a exigir a plataforma específica (Direta/
// Shopee/Mercado Livre) em vez do genérico "Marketplace" + texto livre.
// MARKETPLACE fica só pra não quebrar vendas já registradas antes dessa
// mudança (nunca reescrevemos histórico adivinhando qual plataforma real
// foi usada) -- o formulário de nova venda não oferece mais essa opção.
enum SaleChannel {
  DIRETA
  MARKETPLACE
  SHOPEE
  MERCADO_LIVRE
}

enum MarketplacePlatformKind {
  SHOPEE
  MERCADO_LIVRE
}

// 4.1: taxas de cada marketplace configuráveis (generaliza o par único
// Settings.marketplaceFeePercent/marketplaceFixedFee, que era genérico pra
// "marketplace" em geral). Uma linha por plataforma; seedadas com valores
// zerados porque não há como saber a taxa real de cada uma sem o usuário
// informar -- nunca inventamos um número plausível no lugar de dado real.
model MarketplacePlatform {
  id         String                  @id @default(cuid())
  platform   MarketplacePlatformKind @unique
  feePercent Decimal                 @db.Decimal(5, 4)
  feeFixed   Decimal                 @db.Decimal(10, 2)
  avgFreight Decimal                 @db.Decimal(10, 2)
  updatedAt  DateTime                @updatedAt
}

model Sale {
  id              String      @id @default(cuid())
  channel         SaleChannel
  productId       String
  product         Product     @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal     @db.Decimal(10, 2)
  saleDate        DateTime
  buyerOrPlatform String?
  notes           String?
  // Custo histórico (task-10 brief, new feature -- mirrors ProductionRun's
  // costSnapshot exactly, spec §4 pattern extended here per explicit user
  // request after the final review): calculated ONCE at creation time via
  // createSale (lib/costing.ts#buildSaleCostSnapshot, from
  // getProductCostBreakdown's then-current Printer/Filament/Accessory/
  // Supply/Settings values) and never rewritten afterwards -- altering
  // Settings/Printer/Filament/Accessory/Supply later must never change an
  // already-recorded sale's displayed profit. Nullable because pre-existing
  // sales (created before this column existed) genuinely have no snapshot --
  // there's no historical state to reconstruct one retroactively (same
  // "don't invent data" precedent as ProductionRun.costSnapshot and the
  // Accessory/Supply purchase-history backfill). getSaleProfit() falls back
  // to a live recompute only for such legacy rows.
  costSnapshot    Json?
  createdAt       DateTime    @default(now())
  order           Order?
}

// 2.4 Sistema de pedidos: registra um pedido recebido (de qualquer canal)
// antes de ele ser produzido/despachado. Ao marcar Concluído
// (actions/orders.ts#updateOrderStatus), cria automaticamente 1 Sale
// vinculada (saleId) e nunca mais recria -- "dar baixa no estoque" é só a
// Sale entrando na conta de getOwnStockSummary (2.2), sem contador
// separado. unitPrice fica no pedido (não só na Sale resultante) porque
// precisa existir ANTES da conclusão pra poder criar a Sale com ele.
enum OrderChannel {
  DIRETA
  SHOPEE
  MERCADO_LIVRE
}

enum OrderStatus {
  RECEBIDO
  EM_PRODUCAO
  PRONTO
  DESPACHADO
  CONCLUIDO
}

model Order {
  id          String       @id @default(cuid())
  channel     OrderChannel
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal      @db.Decimal(10, 2)
  orderDate   DateTime
  status      OrderStatus  @default(RECEBIDO)
  orderNumber String?
  notes       String?
  saleId      String?      @unique
  sale        Sale?        @relation(fields: [saleId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ConsignmentPartner {
  id                       String                @id @default(cuid())
  name                     String
  defaultCommissionPercent Decimal               @db.Decimal(5, 4)
  notes                    String?
  active                   Boolean               @default(true)
  createdAt                DateTime              @default(now())
  deliveries               ConsignmentDelivery[]
}

model ConsignmentDelivery {
  id                String                  @id @default(cuid())
  partnerId         String
  partner           ConsignmentPartner      @relation(fields: [partnerId], references: [id])
  productId         String
  product           Product                 @relation(fields: [productId], references: [id])
  quantityDelivered Int
  unitPrice         Decimal                 @db.Decimal(10, 2)
  deliveryDate      DateTime
  notes             String?
  createdAt         DateTime                @default(now())
  saleReports       ConsignmentSaleReport[]
}

model ConsignmentSaleReport {
  id                String              @id @default(cuid())
  deliveryId        String
  delivery          ConsignmentDelivery @relation(fields: [deliveryId], references: [id])
  quantitySold      Int
  reportDate        DateTime
  commissionPercent Decimal             @db.Decimal(5, 4)
  notes             String?
  createdAt         DateTime            @default(now())
}

// 2.6 Ajuste de estoque com justificativa: um log único pra Filamentos,
// Acessórios, Insumos e Meu Estoque (produtos acabados) em vez de 4
// tabelas quase idênticas. `resourceId` aponta pro id de Filament/
// Accessory/Supply/Product conforme resourceType -- sem FK física (um
// campo só não dá pra apontar pra 4 tabelas diferentes sem 4 colunas
// nullable), é um log de auditoria append-only, nunca a fonte de verdade
// do estoque em si:
//   - Filament/Accessory/Supply têm currentStock(Grams) próprio -- o
//     ajuste ESCREVE nesse campo diretamente (actions/stockAdjustments.ts)
//     e este registro só guarda o histórico do que mudou e por quê.
//   - Product não tem contador físico (estoque é sempre derivado,
//     lib/reports.ts#getOwnStockSummary) -- pra ele, `difference` deste
//     registro é somado na fórmula de "disponível" em vez de escrever em
//     algum lugar; "nova quantidade" no formulário só serve pra calcular
//     esse difference (newQty - quantidade atual calculada no momento).
enum StockAdjustmentResourceType {
  FILAMENT
  ACCESSORY
  SUPPLY
  PRODUCT
}

enum StockAdjustmentReason {
  INVENTARIO_FISICO
  PERDA_DANO
  PERDA_FALHA_IMPRESSAO
  PRODUTO_VENCIDO
  CORRECAO_CADASTRO
  CONSUMO_NAO_REGISTRADO
  OUTRO
}

model StockAdjustment {
  id           String                      @id @default(cuid())
  resourceType StockAdjustmentResourceType
  resourceId   String
  previousQty  Decimal                     @db.Decimal(12, 3)
  newQty       Decimal                     @db.Decimal(12, 3)
  difference   Decimal                     @db.Decimal(12, 3)
  reason       StockAdjustmentReason
  reasonNote   String?
  createdAt    DateTime                    @default(now())

  @@index([resourceType, resourceId])
}
